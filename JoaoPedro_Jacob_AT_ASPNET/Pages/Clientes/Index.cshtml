@page
@model JoaoPedro_Jacob_AT_ASPNET.Pages.Clientes.IndexModel

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Clientes</h1>
    <a asp-page="Create" class="btn btn-primary btn-sm">+ Novo Cliente</a>
</div>

@if (!Model.Cliente.Any())
{
    <div class="alert alert-info">Nenhum cliente cadastrado.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-primary">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Cliente[0].Nome)</th>
                <th>@Html.DisplayNameFor(model => model.Cliente[0].Email)</th>
                <th>@Html.DisplayNameFor(model => model.Cliente[0].Telefone)</th>
                <th>Reservas</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Cliente)
        {
            var totalReservas = Model.ReservasPorCliente.TryGetValue(item.Id, out var t) ? t : 0;
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                <td>@Html.DisplayFor(modelItem => item.Telefone)</td>
                <td><span class="badge bg-secondary">@totalReservas</span></td>
                <td>
                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Detalhes</a>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Editar</a>
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Excluir</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
