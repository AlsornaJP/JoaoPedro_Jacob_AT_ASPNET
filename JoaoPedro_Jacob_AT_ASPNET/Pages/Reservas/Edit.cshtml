@page "{id:int}"
@model JoaoPedro_Jacob_AT_ASPNET.Pages.Reservas.EditModel

@{
    ViewData["Title"] = "Editar Reserva";
}

<h1>Editar Reserva</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <input type="hidden" asp-for="Reserva.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Reserva.ClienteId" class="control-label"></label>
                <select asp-for="Reserva.ClienteId" class="form-control" asp-items="Model.ClientesSelectList">
                    <option value="">-- Selecione --</option>
                </select>
                <span asp-validation-for="Reserva.ClienteId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Reserva.PacoteTuristicoId" class="control-label"></label>
                <select asp-for="Reserva.PacoteTuristicoId" class="form-control" asp-items="Model.PacotesSelectList">
                    <option value="">-- Selecione --</option>
                </select>
                <span asp-validation-for="Reserva.PacoteTuristicoId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Reserva.DataReserva" class="control-label"></label>
                <input asp-for="Reserva.DataReserva" class="form-control" type="date" />
                <span asp-validation-for="Reserva.DataReserva" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Reserva.Quantidade" class="control-label"></label>
                <input asp-for="Reserva.Quantidade" class="form-control" type="number" min="1" />
                <span asp-validation-for="Reserva.Quantidade" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="Index">Voltar à lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
