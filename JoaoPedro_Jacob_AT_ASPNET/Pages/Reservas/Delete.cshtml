@page "{id:int}"
@model JoaoPedro_Jacob_AT_ASPNET.Pages.Reservas.DeleteModel

@{
    ViewData["Title"] = "Excluir Reserva";
}

<h1>Excluir Reserva</h1>
<hr />

<div class="alert alert-warning">
    Tem certeza que deseja excluir esta reserva?
</div>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Reserva.Cliente)</dt>
    <dd class="col-sm-9">@Model.Reserva.Cliente?.Nome</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Reserva.PacoteTuristico)</dt>
    <dd class="col-sm-9">@Model.Reserva.PacoteTuristico?.Titulo</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Reserva.DataReserva)</dt>
    <dd class="col-sm-9">@Model.Reserva.DataReserva.ToString("dd/MM/yyyy")</dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="Reserva.Id" />
    <input type="submit" value="Excluir" class="btn btn-danger" />
    <a asp-page="./Index" class="btn btn-secondary">Cancelar</a>
</form>
