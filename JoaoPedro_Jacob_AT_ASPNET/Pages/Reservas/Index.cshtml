@page
@model JoaoPedro_Jacob_AT_ASPNET.Pages.Reservas.IndexModel

@{
    ViewData["Title"] = "Reservas";
}

<h1>Reservas</h1>

@if (!Model.Reserva.Any())
{
    <div class="alert alert-info mt-3">Nenhuma reserva encontrada. <a asp-page="/PacotesTuristicos/Index">Ver pacotes disponíveis</a>.</div>
}
else
{
    <table class="table table-striped table-hover mt-3">
        <thead class="table-primary">
            <tr>
                <th>Cliente</th>
                <th>Pacote</th>
                <th>Lugares</th>
                <th>Data</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Reserva)
            {
                <tr>
                    <td>@item.Cliente?.Nome</td>
                    <td>@item.PacoteTuristico?.Titulo</td>
                    <td>@item.Quantidade</td>
                    <td>@item.DataReserva.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Detalhes</a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Cancelar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
