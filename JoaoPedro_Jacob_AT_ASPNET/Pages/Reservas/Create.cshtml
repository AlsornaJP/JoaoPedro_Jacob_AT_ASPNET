@page
@model JoaoPedro_Jacob_AT_ASPNET.Pages.Reservas.CreateModel

@{
    ViewData["Title"] = "Comprar Pacote";
}

<h1>Comprar Pacote</h1>
<hr />

@if (Model.ErroVagas != null)
{
    <div class="alert alert-danger">@Model.ErroVagas</div>
}

@if (Model.Pacote != null)
{
    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white fw-bold">Pacote selecionado</div>
        <div class="card-body">
            <h5 class="card-title">@Model.Pacote.Titulo</h5>
            <p class="card-text text-muted">@Model.Pacote.Descricao</p>
            <ul class="list-unstyled small mb-0">
                <li><strong>Destinos:</strong> @string.Join(", ", Model.Pacote.Destinos.Select(d => d.Nome))</li>
                <li><strong>Saída:</strong> @Model.Pacote.DataInicio.ToString("dd/MM/yyyy")</li>
                <li><strong>Preço:</strong> <span class="text-success fw-bold">@Model.Pacote.Preco.ToString("C")</span></li>
                <li>
                    <strong>Vagas disponíveis:</strong>
                    <span class="badge bg-success">@Model.VagasDisponiveis</span>
                </li>
            </ul>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-5">
        <h5>Seus dados</h5>
        <form method="post">
            <input type="hidden" asp-for="PacoteId" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" placeholder="Ex: João Silva" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" readonly />
                <small class="text-muted">Você está comprando com a conta logada.</small>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Telefone" class="form-label"></label>
                <input asp-for="Telefone" class="form-control" placeholder="Ex: (11) 99999-0000" />
                <span asp-validation-for="Telefone" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Quantidade" class="form-label"></label>
                <input asp-for="Quantidade" class="form-control" type="number" min="1" max="@Model.VagasDisponiveis" />
                <span asp-validation-for="Quantidade" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Confirmar Reserva</button>
                <a asp-page="/PacotesTuristicos/Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
