@page
@model JoaoPedro_Jacob_AT_ASPNET.Pages.Destinos.IndexModel

@{
    ViewData["Title"] = "Destinos";
}

<div class="mb-4">
    <h1 class="mb-0">Nossos Destinos</h1>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    @foreach (var item in Model.Destino)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height:180px; font-size:4rem;">
                    🌍
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">@item.Nome</h5>
                    <h6 class="card-subtitle mb-2 text-muted">
                        <span class="badge bg-secondary">@item.Pais</span>
                    </h6>
                    @if (!string.IsNullOrEmpty(item.Descricao))
                    {
                        <p class="card-text text-muted flex-grow-1">@item.Descricao</p>
                    }
                </div>
                <div class="card-footer bg-transparent d-flex gap-2">
                    <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Detalhes</a>
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm ms-auto">Excluir</a>
                </div>
            </div>
        </div>
    }
</div>
