@page
@model JoaoPedro_Jacob_AT_ASPNET.Pages.DescontoPacote.IndexModel

@{
    ViewData["Title"] = "Cálculo de Desconto";
}

<h1>Cálculo de Desconto</h1>
<p class="text-muted">Selecione um pacote e aplique 10% de desconto sobre o preço dele.</p>
<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="PacoteId" class="form-label fw-bold">Pacote Turístico</label>
                <select asp-for="PacoteId" class="form-select" asp-items="Model.PacotesSelectList">
                    <option value="">-- Selecione um pacote --</option>
                </select>
            </div>
            <div class="form-group">
                <input type="submit" value="Calcular Desconto" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@if (Model.PrecoComDesconto.HasValue && Model.PacoteSelecionado != null)
{
    <div class="mt-4 alert alert-success">
        <h4>Resultado</h4>
        <p>Pacote: <strong>@Model.PacoteSelecionado.Titulo</strong></p>
        <p>Preço original: <strong>@Model.PacoteSelecionado.Preco.ToString("C")</strong></p>
        <p>Desconto aplicado: <strong>10%</strong></p>
        <p>Preço com desconto: <strong>@Model.PrecoComDesconto.Value.ToString("C")</strong></p>
    </div>
}

<div class="mt-3">
    <a asp-page="/Index">Voltar</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
