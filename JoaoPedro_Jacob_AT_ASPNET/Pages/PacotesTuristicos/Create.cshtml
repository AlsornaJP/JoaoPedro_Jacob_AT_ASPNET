@page
@model JoaoPedro_Jacob_AT_ASPNET.Pages.PacotesTuristicos.CreateModel

@{
    ViewData["Title"] = "Novo Pacote Turístico";
}

<h1>Novo Pacote Turístico</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="PacoteTuristico.Titulo" class="control-label"></label>
                <input asp-for="PacoteTuristico.Titulo" class="form-control" />
                <span asp-validation-for="PacoteTuristico.Titulo" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PacoteTuristico.Descricao" class="control-label"></label>
                <textarea asp-for="PacoteTuristico.Descricao" class="form-control" rows="3"></textarea>
                <span asp-validation-for="PacoteTuristico.Descricao" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PacoteTuristico.DataInicio" class="control-label"></label>
                <input asp-for="PacoteTuristico.DataInicio" class="form-control" type="date" />
                <span asp-validation-for="PacoteTuristico.DataInicio" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PacoteTuristico.CapacidadeMaxima" class="control-label"></label>
                <input asp-for="PacoteTuristico.CapacidadeMaxima" class="form-control" type="number" min="1" />
                <span asp-validation-for="PacoteTuristico.CapacidadeMaxima" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PacoteTuristico.Preco" class="control-label"></label>
                <input asp-for="PacoteTuristico.Preco" class="form-control" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="PacoteTuristico.Preco" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label class="control-label">Destinos</label>
                @foreach (var destino in Model.DestinosDisponiveis)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               name="DestinosSelecionados"
                               value="@destino.Id"
                               id="destino_@destino.Id"
                               @(Model.DestinosSelecionados.Contains(destino.Id) ? "checked" : "") />
                        <label class="form-check-label" for="destino_@destino.Id">
                            @destino.Nome — @destino.Pais
                        </label>
                    </div>
                }
            </div>
            <div class="form-group">
                <input type="submit" value="Cadastrar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="Index">Voltar à lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
