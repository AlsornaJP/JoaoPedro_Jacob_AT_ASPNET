@page
@model JoaoPedro_Jacob_AT_ASPNET.Pages.PacotesTuristicos.IndexModel

@{
    ViewData["Title"] = "Pacotes Turísticos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Pacotes Turísticos</h1>
    <a asp-page="Create" class="btn btn-primary btn-sm">+ Novo Pacote</a>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    @foreach (var info in Model.Pacotes)
    {
        var p = info.Pacote;
        var vagas = info.VagasDisponiveis;
        var dataPassada = p.DataInicio <= DateTime.Today;

        <div class="col">
            <div class="card h-100 shadow-sm @(!info.Disponivel ? "border-danger" : "")">
                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height:180px; font-size:4rem;">
                    ✈️
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold">@p.Titulo</h5>
                    <p class="card-text text-muted flex-grow-1">@p.Descricao</p>

                    <ul class="list-unstyled small mb-3">
                        <li><strong>Destinos:</strong> @string.Join(", ", p.Destinos.Select(d => d.Nome))</li>
                        <li><strong>Saída:</strong> @p.DataInicio.ToString("dd/MM/yyyy")</li>
                        <li><strong>Preço:</strong> <span class="text-success fw-bold">@p.Preco.ToString("C")</span></li>
                        <li>
                            <strong>Vagas:</strong>
                            @if (vagas <= 0)
                            {
                                <span class="badge bg-danger">Esgotado</span>
                            }
                            else if (dataPassada)
                            {
                                <span class="badge bg-secondary">Encerrado</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@vagas disponível(is)</span>
                            }
                        </li>
                    </ul>

                    @if (info.Disponivel)
                    {
                        <a asp-page="/Reservas/Create" asp-route-pacoteId="@p.Id"
                           class="btn btn-primary w-100">Comprar</a>
                    }
                    else if (dataPassada)
                    {
                        <button class="btn btn-secondary w-100" disabled>Encerrado</button>
                    }
                    else
                    {
                        <button class="btn btn-secondary w-100" disabled>Esgotado</button>
                    }
                </div>
                <div class="card-footer bg-transparent d-flex gap-2">
                    <a asp-page="./Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm">Editar</a>
                    <a asp-page="./Details" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm">Detalhes</a>
                    <a asp-page="./Delete" asp-route-id="@p.Id" class="btn btn-outline-danger btn-sm ms-auto">Excluir</a>
                </div>
            </div>
        </div>
    }
</div>
